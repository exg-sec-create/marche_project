rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /registrations/{id} {
      allow create: if isValidNew();
      allow get:    if true;
      allow list:   if isStaff();
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    function isStaff() {
      return request.auth != null;
    }

    function isValidNew() {
      let d = request.resource.data;
      return d.name is string
          && d.name.size() > 0
          && d.name.size() <= 100
          && d.email is string
          && d.email.size() <= 200
          && d.tel is string
          && d.tel.matches('^(070|080|090)[0-9]{8}$')
          && !d.tel.matches('.*(000000|111111|222222|333333|444444|555555|666666|777777|888888|999999|012345|123456|234567|345678|456789|987654|876543|765432|654321|543210).*')
          && d.slot is string
          && d.slot.size() <= 40
          && d.registrationType in ['owner', 'general', 'referral', 'vendor']
          && d.checkedIn == false
          && d.checkedInAt == null;
    }
  }
}
