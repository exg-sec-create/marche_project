rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /registrations/{id} {
      allow create: if isValidNew();
      allow get:    if true;
      allow list:   if isStaff();
      allow update: if isStaff();
      allow delete: if canDeleteRegistration();
    }

    // 既存顧客マスターは、認証済み運営スタッフだけが参照・登録できます。
    // 申込フォームなど、未認証の公開画面からはアクセスできません。
    match /customerMasters/{customerId} {
      allow read, create, update: if isStaff();
      allow delete: if false;
    }

    function isStaff() {
      return request.auth != null;
    }

    function canDeleteRegistration() {
      return request.auth != null
          && request.auth.token.email is string
          && request.auth.token.email in [
            'tegawa@ych-exceed.com',
            'hayasaka@ych-exceed.com',
            'takeuchi_23@besto-haus.com'
          ];
    }

    function isValidNew() {
      let d = request.resource.data;
      return d.name is string
          && d.name.size() > 0
          && d.name.size() <= 100
          && d.email is string
          && d.email.size() <= 200
          && d.tel is string
          && d.tel.matches('^(070|080|090)[0-9]{8}$')
          && !d.tel.matches('.*(000000|111111|222222|333333|444444|555555|666666|777777|888888|999999|012345|123456|234567|345678|456789|987654|876543|765432|654321|543210).*')
          && d.slot is string
          && d.slot.size() <= 40
          && d.registrationType in ['owner', 'general', 'referral', 'vendor']
          && d.adultCount is string
          && d.childCount is string
          && (d.registrationType == 'vendor'
              ? d.adultCount == '' && d.childCount == ''
              : d.adultCount in ['1', '2', '3', '4', '5', '6+']
                && d.childCount in ['0', '1', '2', '3', '4', '5', '6+'])
          && d.checkedIn == false
          && d.checkedInAt == null
          && d.eventParticipated == false
          && d.eventParticipatedAt == null;
    }
  }
}
